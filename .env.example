# ===== News API (빅카인즈 / 뉴스스토어) =====
NEWS_API_ACCESS_KEY=your-news-api-access-key

# ===== Neo4j Aura =====
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===== NAVER HyperCLOVA X =====
CLOVA_API_KEY=your-clova-api-key
CLOVA_APP_TYPE=testapp
CLOVA_MODEL=HCX-007

# ===== MySQL (espo / Dump_Espo.sql) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=espo

# ===== CORS (프론트엔드 주소, 쉼표로 여러 개 지정 가능) =====
CORS_ORIGINS=*
