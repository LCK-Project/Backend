# ===== News API (빅카인즈 / 뉴스스토어) =====
NEWS_API_ACCESS_KEY=your-news-api-access-key

# ===== Neo4j Aura =====
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===== NAVER HyperCLOVA X =====
CLOVA_API_KEY=your-clova-api-key
CLOVA_APP_TYPE=testapp
CLOVA_MODEL=HCX-007

# ===== MySQL (espo / Dump_Espo.sql) =====
# 계정은 root 고정이다(MYSQL_USER=root). docker compose 의 mysql 컨테이너가 이 비밀번호로 root 를 만든다.
# MYSQL_PASSWORD 는 비워 두면 안 된다. 비어 있으면 docker compose 가 변수 오류로 즉시 멈춘다.
# HOST·PORT 는 Docker 없이 호스트에서 실행할 때의 값이다. compose 의 api 컨테이너는 mysql:3306 으로 덮어쓴다.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=espo

# ===== CORS (프론트엔드 주소, 쉼표로 여러 개 지정 가능) =====
CORS_ORIGINS=*

# ===== Docker 호스트 포트 (선택, 기본값 MySQL 3307 · API 8000) =====
# MYSQL_HOST_PORT=3307
# API_HOST_PORT=8000
